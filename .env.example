# Copia este archivo como .env
PORT=8080
DB_PATH=./energy.db
DATA_DIR=./backend/data
CORS_ORIGIN=http://localhost:5173

# Proveedor de IA generativa (Gemini o Claude)
# Si no se define API key, la plataforma utiliza el motor determinista de explicabilidad
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

AI_TIMEOUT_SECONDS=25
# true = corre el análisis automáticamente al iniciar la API
ANALYZE_ON_START=false
